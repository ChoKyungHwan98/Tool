    "build:studio": "pnpm --filter @game-presentation/workbench build",
    "build:workbench": "pnpm proof:candidates && pnpm --filter @game-presentation/workbench build"
  },
  "dependencies": {
    "pdfjs-dist": "6.2.108",
    "playwright": "1.62.1",
    "sharp": "0.35.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
