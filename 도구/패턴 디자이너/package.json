{
  "name": "combat-pattern-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "tsc -b && vite build",
    "build:studio": "tsc -b && vite build --mode studio --base=/tools/pattern/ --outDir=dist-studio",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:import-dummy": "powershell -ExecutionPolicy Bypass -File scripts/import-human-character-dummy.ps1",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.5",
    "@tauri-apps/api": "^2.8.0",
    "@xyflow/react": "^12.11.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mistreevous": "^4.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "xstate": "^5.32.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/dagre": "^0.7.54",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
