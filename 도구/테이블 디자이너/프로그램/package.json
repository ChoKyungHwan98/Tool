{
  "name": "game-schema-workbench",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop data schema IDE for game designers.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri": "tauri",
    "build": "tsc -b && vite build",
    "build:studio": "tsc -b && vite build --base=/tools/table/ --outDir=dist-studio",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:run": "vitest run",
    "e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "eval:local": "vitest run modelEvaluation",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.6",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tisoap/react-flow-smart-edge": "4.13.0",
    "@xyflow/react": "^12.11.1",
    "clsx": "^2.1.1",
    "elkjs": "^0.11.1",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "read-excel-file": "^9.3.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.11.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
