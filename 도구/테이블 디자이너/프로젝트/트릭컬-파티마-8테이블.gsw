          "tbl_character_state.murmur": "…제가 뭘 놓친 걸까요."
        }
      },
      {
        "rowId": "row_tbl_character_state_0038",
        "cells": {
          "tbl_character_state.id": 40007,
          "tbl_character_state.character_id": 10003,
          "tbl_character_state.state_type": "normal",
          "tbl_character_state.idle_anim": "Idle_1",
          "tbl_character_state.observe_hint": "평소와 다르지 않다",
          "tbl_character_state.murmur": "오늘은 좀 한가하네."
        }
      },
      {
        "rowId": "row_tbl_character_state_0039",
        "cells": {
          "tbl_character_state.id": 40008,
          "tbl_character_state.character_id": 10003,
          "tbl_character_state.state_type": "gloomy",
          "tbl_character_state.idle_anim": "Sad_2",
          "tbl_character_state.observe_hint": "혼자 떨어져 있다",
          "tbl_character_state.murmur": "…혼자 있고 싶은 날이 있잖아요."
        }
      },
      {
        "rowId": "row_tbl_character_state_0040",
        "cells": {
          "tbl_character_state.id": 40009,
          "tbl_character_state.character_id": 10004,
          "tbl_character_state.state_type": "normal",
          "tbl_character_state.idle_anim": "Idle_1",
          "tbl_character_state.observe_hint": "업무 사이에 숨을 고르고 있다",
          "tbl_character_state.murmur": "오늘 일정도 차근차근 정리해 볼게요."
        }
      },
      {
        "rowId": "row_tbl_character_state_0041",
        "cells": {
          "tbl_character_state.id": 40010,
          "tbl_character_state.character_id": 10005,
          "tbl_character_state.state_type": "normal",
          "tbl_character_state.idle_anim": "Idle_1",
          "tbl_character_state.observe_hint": "기록과 모니터를 번갈아 확인한다",
          "tbl_character_state.murmur": "이 시간대는 제가 지키고 있어요."
        }
      },
      {
        "rowId": "row_tbl_character_state_0042",
        "cells": {
          "tbl_character_state.id": 40011,
          "tbl_character_state.character_id": 10006,
          "tbl_character_state.state_type": "normal",
          "tbl_character_state.idle_anim": "Idle_1",
          "tbl_character_state.observe_hint": "비품을 챙기며 분주하다",
          "tbl_character_state.murmur": "필요한 거 있으면 말해."
        }
      }
    ],
    "tbl_interaction": [
      {
        "rowId": "row_tbl_interaction_0043",
        "cells": {
          "tbl_interaction.id": 50001,
          "tbl_interaction.character_state_id": 40002,
          "tbl_interaction.area_id": 20001,
          "tbl_interaction.name": "따뜻한 음료를 건넨다",
          "tbl_interaction.action_type": "warm_drink",
          "tbl_interaction.available_period": "day",
          "tbl_interaction.scene_cue": "옆 책상 두 자리가 아직 차 있다",
          "tbl_interaction.result_anim": "Happy_3",
          "tbl_interaction.result_text": "…따뜻하네요. 지금은 이 정도가 딱 좋아요.",
          "tbl_interaction.same_day_text": "낮에 아무것도 안 물어보고 두고 가셨죠. 그게 편했어요.",
          "tbl_interaction.next_day_text": "어제 그 음료 잘 마셨어요. 오늘은 좀 나아요.",
          "tbl_interaction.affinity_point": 1
        }
      },
      {
        "rowId": "row_tbl_interaction_0044",
        "cells": {
          "tbl_interaction.id": 50002,
          "tbl_interaction.character_state_id": 40002,
          "tbl_interaction.area_id": 20001,
          "tbl_interaction.name": "빈 의자에 앉는다",
          "tbl_interaction.action_type": "sit_quietly",
          "tbl_interaction.available_period": "day",
          "tbl_interaction.scene_cue": "옆 책상 두 자리가 아직 차 있다",
          "tbl_interaction.result_anim": "Think_1",
          "tbl_interaction.result_text": "…지금요? 다들 보고 있는데요. 그래도, 고마워요.",
          "tbl_interaction.same_day_text": "낮엔 사람이 많아서 좀 민망했어요. 그래도 옆에 있어 주셨죠.",
          "tbl_interaction.next_day_text": "어제 낮엔 제가 좀 당황했어요. 그래도 좋았어요.",
          "tbl_interaction.affinity_point": 1
        }
      },
      {
        "rowId": "row_tbl_interaction_0045",
        "cells": {
          "tbl_interaction.id": 50005,
          "tbl_interaction.character_state_id": 40003,
          "tbl_interaction.area_id": 20001,
          "tbl_interaction.name": "남은 일을 대신 맡는다",
          "tbl_interaction.action_type": "take_over",
          "tbl_interaction.available_period": "day",
          "tbl_interaction.scene_cue": "서류를 넘기다 같은 장을 자꾸 다시 본다",
          "tbl_interaction.result_anim": "Happy_1",
          "tbl_interaction.result_text": "…그건 제가 해야 하는데. 오늘은 그냥 맡길게요.",
          "tbl_interaction.same_day_text": "낮에 제 몫까지 봐주셔서 오후가 좀 가벼웠어요.",
          "tbl_interaction.next_day_text": "어제 대신 맡아주신 거 다 끝냈어요. 고마워요.",
          "tbl_interaction.affinity_point": 1
        }
      },
      {
        "rowId": "row_tbl_interaction_0046",
        "cells": {
          "tbl_interaction.id": 50006,
          "tbl_interaction.character_state_id": 40003,
          "tbl_interaction.area_id": 20001,
          "tbl_interaction.name": "조용히 이유를 묻는다",
          "tbl_interaction.action_type": "ask_quietly",
          "tbl_interaction.available_period": "day",
          "tbl_interaction.scene_cue": "서류를 넘기다 같은 장을 자꾸 다시 본다",
          "tbl_interaction.result_anim": "Think_1",
          "tbl_interaction.result_text": "…여기서 말하긴 좀 그래요. 마음만 받을게요.",
          "tbl_interaction.same_day_text": "낮에 물어보셨던 거요. 지금이면 말할 수 있어요.",
          "tbl_interaction.next_day_text": "어제 낮엔 대답을 못 드렸죠. 지금은 괜찮아요.",
          "tbl_interaction.affinity_point": 1
        }
      },
      {
        "rowId": "row_tbl_interaction_0047",
        "cells": {
          "tbl_interaction.id": 50009,
          "tbl_interaction.character_state_id": 40004,
          "tbl_interaction.area_id": 20001,
          "tbl_interaction.name": "자리를 비켜 준다",
          "tbl_interaction.action_type": "give_space",
          "tbl_interaction.available_period": "day",
          "tbl_interaction.scene_cue": "회의실 쪽을 한 번 보고는 말없이 앉는다",
          "tbl_interaction.result_anim": "Blank_1",
          "tbl_interaction.result_text": "…네. 조금만 이대로 둘게요.",
          "tbl_interaction.same_day_text": "낮엔 그냥 둬 주셨죠. 사실 그게 제일 나았어요.",
          "tbl_interaction.next_day_text": "어제는 그냥 둬 주셔서 편했어요.",
          "tbl_interaction.affinity_point": 1
        }
      },
      {
        "rowId": "row_tbl_interaction_0048",
        "cells": {
          "tbl_interaction.id": 50010,
          "tbl_interaction.character_state_id": 40004,
          "tbl_interaction.area_id": 20001,
          "tbl_interaction.name": "무슨 일이었는지 듣는다",
          "tbl_interaction.action_type": "hear_out",
          "tbl_interaction.available_period": "day",
          "tbl_interaction.scene_cue": "회의실 쪽을 한 번 보고는 말없이 앉는다",
          "tbl_interaction.result_anim": "Think_1",
          "tbl_interaction.result_text": "…지금은 말이 잘 안 나와요. 나중에요.",
          "tbl_interaction.same_day_text": "낮엔 정리가 안 됐어요. 지금은 말할 수 있어요.",
          "tbl_interaction.next_day_text": "어제 낮엔 말이 안 나왔어요. 오늘은 괜찮아요.",
          "tbl_interaction.affinity_point": 1
        }
      },
      {
        "rowId": "row_tbl_interaction_0049",
        "cells": {
          "tbl_interaction.id": 50003,
          "tbl_interaction.character_state_id": 40002,
          "tbl_interaction.area_id": 20006,
          "tbl_interaction.name": "따뜻한 음료를 건넨다",
          "tbl_interaction.action_type": "warm_drink",
          "tbl_interaction.available_period": "night",
          "tbl_interaction.scene_cue": "혼자 앉아 잔만 만지작거리고 있다",
          "tbl_interaction.result_anim": "Blank_1",
          "tbl_interaction.result_text": "…놓고 가시는군요. 잘 마실게요.",
          "tbl_interaction.same_day_text": null,
          "tbl_interaction.next_day_text": "어제는 금방 가셨죠. 조금 더 있어도 됐는데.",
          "tbl_interaction.affinity_point": 1
        }
      },
      {
        "rowId": "row_tbl_interaction_0050",
        "cells": {
          "tbl_interaction.id": 50004,
          "tbl_interaction.character_state_id": 40002,
          "tbl_interaction.area_id": 20006,
          "tbl_interaction.name": "빈 의자에 앉는다",
          "tbl_interaction.action_type": "sit_quietly",
          "tbl_interaction.available_period": "night",
          "tbl_interaction.scene_cue": "혼자 앉아 잔만 만지작거리고 있다",
          "tbl_interaction.result_anim": "Happy_1",
          "tbl_interaction.result_text": "…아무 말 안 해도 괜찮네요. 이대로 조금만요.",
          "tbl_interaction.same_day_text": null,
          "tbl_interaction.next_day_text": "어제 옆에 있어 줘서 고마웠어요.",
          "tbl_interaction.affinity_point": 1
        }
      },
      {
        "rowId": "row_tbl_interaction_0051",
        "cells": {
          "tbl_interaction.id": 50007,
          "tbl_interaction.character_state_id": 40003,
          "tbl_interaction.area_id": 20006,
          "tbl_interaction.name": "남은 일을 대신 맡는다",
          "tbl_interaction.action_type": "take_over",
          "tbl_interaction.available_period": "night",
          "tbl_interaction.scene_cue": "말을 하다 말고 선배 쪽을 몇 번 바라본다",
          "tbl_interaction.result_anim": "Sad_1",
          "tbl_interaction.result_text": "…이 시간에 일 얘기는 좀 그래요.",
          "tbl_interaction.same_day_text": null,
          "tbl_interaction.next_day_text": "어제 밤엔 일 얘기로 끝났네요.",
          "tbl_interaction.affinity_point": 1
        }
      },
      {
        "rowId": "row_tbl_interaction_0052",
        "cells": {
          "tbl_interaction.id": 50008,
          "tbl_interaction.character_state_id": 40003,
          "tbl_interaction.area_id": 20006,
          "tbl_interaction.name": "조용히 이유를 묻는다",
          "tbl_interaction.action_type": "ask_quietly",
          "tbl_interaction.available_period": "night",
          "tbl_interaction.scene_cue": "말을 하다 말고 선배 쪽을 몇 번 바라본다",
          "tbl_interaction.result_anim": "Happy_1",
          "tbl_interaction.result_text": "…사실은요. 오늘 있었던 일 말인데, 들어주실래요?",
          "tbl_interaction.same_day_text": null,
          "tbl_interaction.next_day_text": "어제 들어주셔서 마음이 가벼워졌어요.",
          "tbl_interaction.affinity_point": 1
        }
      },
      {
        "rowId": "row_tbl_interaction_0053",
        "cells": {
          "tbl_interaction.id": 50011,
          "tbl_interaction.character_state_id": 40004,
          "tbl_interaction.area_id": 20006,
          "tbl_interaction.name": "자리를 비켜 준다",
          "tbl_interaction.action_type": "give_space",
          "tbl_interaction.available_period": "night",
          "tbl_interaction.scene_cue": "옆자리에 네르가 앉아 있고 잔을 내려놓지 않는다",
          "tbl_interaction.result_anim": "Blank_1",
          "tbl_interaction.result_text": "…고마워요. 여기서 할 얘기는 아니라서.",
          "tbl_interaction.same_day_text": null,
          "tbl_interaction.next_day_text": "어제 그냥 넘어가 주셔서 편했어요.",
          "tbl_interaction.affinity_point": 1
        }
      },
      {
        "rowId": "row_tbl_interaction_0054",
        "cells": {
          "tbl_interaction.id": 50012,
          "tbl_interaction.character_state_id": 40004,
          "tbl_interaction.area_id": 20006,
          "tbl_interaction.name": "무슨 일이었는지 듣는다",
          "tbl_interaction.action_type": "hear_out",
          "tbl_interaction.available_period": "night",
          "tbl_interaction.scene_cue": "옆자리에 네르가 앉아 있고 잔을 내려놓지 않는다",
          "tbl_interaction.result_anim": "Think_1",
          "tbl_interaction.result_text": "…옆에 네르 있는데요. 나중에요.",
          "tbl_interaction.same_day_text": null,
          "tbl_interaction.next_day_text": "어제는 자리가 그래서 말을 못 했어요.",
          "tbl_interaction.affinity_point": 1
        }
      },
      {
        "rowId": "row_tbl_interaction_0055",
        "cells": {
          "tbl_interaction.id": 50013,
          "tbl_interaction.character_state_id": 40006,
          "tbl_interaction.area_id": 20001,
          "tbl_interaction.name": "따뜻한 음료를 건넨다",
          "tbl_interaction.action_type": "warm_drink",
          "tbl_interaction.available_period": "day",
          "tbl_interaction.scene_cue": "서류를 정리하다 손이 자꾸 멈춘다",
          "tbl_interaction.result_anim": "Happy_4",
          "tbl_interaction.result_text": "…감사합니다. 지금은 이 정도가 적당합니다.",
          "tbl_interaction.same_day_text": "낮에 조용히 두고 가신 건 배려로 받았습니다.",
          "tbl_interaction.next_day_text": "어제 그 음료는 도움이 됐습니다.",
          "tbl_interaction.affinity_point": 1
        }
      },
      {
        "rowId": "row_tbl_interaction_0056",
        "cells": {
          "tbl_interaction.id": 50014,
          "tbl_interaction.character_state_id": 40006,
          "tbl_interaction.area_id": 20001,
          "tbl_interaction.name": "빈 의자에 앉는다",
          "tbl_interaction.action_type": "sit_quietly",
          "tbl_interaction.available_period": "day",
          "tbl_interaction.scene_cue": "서류를 정리하다 손이 자꾸 멈춘다",
          "tbl_interaction.result_anim": "Think_1",
          "tbl_interaction.result_text": "…근무 중입니다. 마음만 받겠습니다.",
          "tbl_interaction.same_day_text": "낮엔 자리를 지켜야 했습니다. 지금은 괜찮습니다.",
          "tbl_interaction.next_day_text": "어제 낮엔 응대가 짧았습니다. 죄송합니다.",
          "tbl_interaction.affinity_point": 1
        }
      },
      {
        "rowId": "row_tbl_interaction_0057",
        "cells": {
          "tbl_interaction.id": 50017,
          "tbl_interaction.character_state_id": 40006,
          "tbl_interaction.area_id": 20006,
          "tbl_interaction.name": "따뜻한 음료를 건넨다",
          "tbl_interaction.action_type": "warm_drink",
          "tbl_interaction.available_period": "night",
          "tbl_interaction.scene_cue": "주문한 걸 반쯤 남긴 채 잔만 보고 있다",
          "tbl_interaction.result_anim": "Blank_1",
          "tbl_interaction.result_text": "…한 잔 더는 괜찮습니다. 마음은 받겠습니다.",
          "tbl_interaction.same_day_text": null,
          "tbl_interaction.next_day_text": "어제는 제가 사양했죠. 지금 생각하면 좀 아쉽습니다.",
          "tbl_interaction.affinity_point": 1
        }
      },
      {
        "rowId": "row_tbl_interaction_0058",
        "cells": {
          "tbl_interaction.id": 50018,
          "tbl_interaction.character_state_id": 40006,
          "tbl_interaction.area_id": 20006,
          "tbl_interaction.name": "빈 의자에 앉는다",
          "tbl_interaction.action_type": "sit_quietly",
          "tbl_interaction.available_period": "night",
          "tbl_interaction.scene_cue": "주문한 걸 반쯤 남긴 채 잔만 보고 있다",
          "tbl_interaction.result_anim": "Happy_2",
          "tbl_interaction.result_text": "…앉으시죠. 혼자 있으니 생각만 길어지더군요.",
          "tbl_interaction.same_day_text": null,
          "tbl_interaction.next_day_text": "어제 곁에 계셔 주신 덕분에 정리가 됐습니다.",
          "tbl_interaction.affinity_point": 1
        }
      },
      {
        "rowId": "row_tbl_interaction_0059",
        "cells": {
          "tbl_interaction.id": 50015,
          "tbl_interaction.character_state_id": 40008,
          "tbl_interaction.area_id": 20003,
          "tbl_interaction.name": "따뜻한 음료를 건넨다",
          "tbl_interaction.action_type": "warm_drink",
          "tbl_interaction.available_period": "day",
          "tbl_interaction.scene_cue": "소파 끝에 앉아 화면만 보고 있다",
          "tbl_interaction.result_anim": "Happy_5",
          "tbl_interaction.result_text": "…어 이거 좋네요. 딱 필요했어요.",
          "tbl_interaction.same_day_text": "낮에 슥 놓고 가신 거 봤어요. 안 물어봐 줘서 편했어요.",
          "tbl_interaction.next_day_text": "어제 그거 덕분에 좀 괜찮아졌어요.",
          "tbl_interaction.affinity_point": 1
        }
      },
      {
        "rowId": "row_tbl_interaction_0060",
        "cells": {
          "tbl_interaction.id": 50016,
          "tbl_interaction.character_state_id": 40008,
          "tbl_interaction.area_id": 20003,
          "tbl_interaction.name": "빈 의자에 앉는다",
          "tbl_interaction.action_type": "sit_quietly",
          "tbl_interaction.available_period": "day",
          "tbl_interaction.scene_cue": "소파 끝에 앉아 화면만 보고 있다",
          "tbl_interaction.result_anim": "Happy_1",
          "tbl_interaction.result_text": "…옆에 앉으실래요? 쉬는 시간이니까 괜찮아요.",
          "tbl_interaction.same_day_text": "낮에 옆에 와 준 거 고마웠어요.",
          "tbl_interaction.next_day_text": "어제 같이 있어 줘서 덜 외로웠어요.",
          "tbl_interaction.affinity_point": 1
        }
      },
      {
        "rowId": "row_tbl_interaction_0061",
        "cells": {
          "tbl_interaction.id": 50019,
          "tbl_interaction.character_state_id": 40008,
          "tbl_interaction.area_id": 20001,
          "tbl_interaction.name": "따뜻한 음료를 건넨다",
          "tbl_interaction.action_type": "warm_drink",
          "tbl_interaction.available_period": "night",
          "tbl_interaction.scene_cue": "혼자 남아 모니터 불빛만 보고 있다",
          "tbl_interaction.result_anim": "Happy_5",
          "tbl_interaction.result_text": "…이 시간에 이런 거 받으면 좀 뭉클한데요.",
          "tbl_interaction.same_day_text": null,
          "tbl_interaction.next_day_text": "어제 늦게 챙겨주신 거 기억나요.",
          "tbl_interaction.affinity_point": 1
        }
      },
      {
        "rowId": "row_tbl_interaction_0062",
        "cells": {
          "tbl_interaction.id": 50020,
          "tbl_interaction.character_state_id": 40008,
          "tbl_interaction.area_id": 20001,
          "tbl_interaction.name": "빈 의자에 앉는다",
          "tbl_interaction.action_type": "sit_quietly",
          "tbl_interaction.available_period": "night",
          "tbl_interaction.scene_cue": "혼자 남아 모니터 불빛만 보고 있다",
          "tbl_interaction.result_anim": "Idle_3",
          "tbl_interaction.result_text": "…저 곧 갈 거예요. 먼저 들어가셔도 돼요.",
          "tbl_interaction.same_day_text": null,
          "tbl_interaction.next_day_text": "어제는 제가 먼저 가라고 했죠. 좀 미안했어요.",
          "tbl_interaction.affinity_point": 1
        }
      }
    ],
    "tbl_dialogue": [
      {
        "rowId": "row_tbl_dialogue_0063",
        "cells": {
          "tbl_dialogue.id": 60001,
          "tbl_dialogue.character_id": 10001,
          "tbl_dialogue.area_id": null,
          "tbl_dialogue.min_affinity_id": 70001,
          "tbl_dialogue.dialogue_type": "greeting_first",
          "tbl_dialogue.from_hour": 6,
          "tbl_dialogue.to_hour": 9,
          "tbl_dialogue.text": "선배, 오늘은 일찍 왔네요."
        }
      },
      {
        "rowId": "row_tbl_dialogue_0064",
        "cells": {
          "tbl_dialogue.id": 60002,
          "tbl_dialogue.character_id": 10002,
          "tbl_dialogue.area_id": null,
          "tbl_dialogue.min_affinity_id": 70001,
          "tbl_dialogue.dialogue_type": "greeting_first",
          "tbl_dialogue.from_hour": 9,
          "tbl_dialogue.to_hour": 12,
          "tbl_dialogue.text": "선배, 오전 업무는 먼저 시작했어요."
        }
      },
      {
        "rowId": "row_tbl_dialogue_0065",
        "cells": {
          "tbl_dialogue.id": 60003,
          "tbl_dialogue.character_id": 10005,
          "tbl_dialogue.area_id": null,
          "tbl_dialogue.min_affinity_id": 70001,
          "tbl_dialogue.dialogue_type": "greeting_first",
          "tbl_dialogue.from_hour": 12,
          "tbl_dialogue.to_hour": 18,
          "tbl_dialogue.text": "선배도 이제 왔네요. 회의는 먼저 시작했어요."
        }
      },
      {
        "rowId": "row_tbl_dialogue_0066",
        "cells": {
          "tbl_dialogue.id": 60004,
          "tbl_dialogue.character_id": 10003,
          "tbl_dialogue.area_id": null,
          "tbl_dialogue.min_affinity_id": 70001,
          "tbl_dialogue.dialogue_type": "greeting_first",
          "tbl_dialogue.from_hour": 18,
          "tbl_dialogue.to_hour": 21,
          "tbl_dialogue.text": "선배도 야간 근무예요? 같이 있으니 든든하네요."
        }
      },
      {
        "rowId": "row_tbl_dialogue_0067",
        "cells": {
          "tbl_dialogue.id": 60005,
          "tbl_dialogue.character_id": 10003,
          "tbl_dialogue.area_id": null,
          "tbl_dialogue.min_affinity_id": 70001,
          "tbl_dialogue.dialogue_type": "greeting_first",
          "tbl_dialogue.from_hour": 21,
          "tbl_dialogue.to_hour": 24,
          "tbl_dialogue.text": "이 시간까지 와줄 줄은 몰랐어요."
        }
      },
      {
        "rowId": "row_tbl_dialogue_0068",
        "cells": {
          "tbl_dialogue.id": 60006,
          "tbl_dialogue.character_id": 10003,
          "tbl_dialogue.area_id": null,
          "tbl_dialogue.min_affinity_id": 70001,
          "tbl_dialogue.dialogue_type": "greeting_first",
          "tbl_dialogue.from_hour": 0,
          "tbl_dialogue.to_hour": 6,
          "tbl_dialogue.text": "이 시간에 선배가 와 주니까 잠이 좀 깨네요."
        }
      },
      {
        "rowId": "row_tbl_dialogue_0069",
        "cells": {
          "tbl_dialogue.id": 60007,
          "tbl_dialogue.character_id": 10001,
          "tbl_dialogue.area_id": null,
          "tbl_dialogue.min_affinity_id": 70001,
          "tbl_dialogue.dialogue_type": "greeting_return",
          "tbl_dialogue.from_hour": 6,
          "tbl_dialogue.to_hour": 9,
          "tbl_dialogue.text": "선배, 금방 다시 왔네요."
        }
      },
      {
        "rowId": "row_tbl_dialogue_0070",
        "cells": {
          "tbl_dialogue.id": 60012,
          "tbl_dialogue.character_id": 10002,
          "tbl_dialogue.area_id": null,
          "tbl_dialogue.min_affinity_id": 70001,
          "tbl_dialogue.dialogue_type": "greeting_return",
          "tbl_dialogue.from_hour": 9,
          "tbl_dialogue.to_hour": 12,
          "tbl_dialogue.text": "다시 오셨군요. 오전 업무는 이어지고 있습니다."
        }
      },
      {
        "rowId": "row_tbl_dialogue_0071",
        "cells": {
          "tbl_dialogue.id": 60013,
          "tbl_dialogue.character_id": 10005,
          "tbl_dialogue.area_id": null,
          "tbl_dialogue.min_affinity_id": 70001,
          "tbl_dialogue.dialogue_type": "greeting_return",
          "tbl_dialogue.from_hour": 12,
          "tbl_dialogue.to_hour": 18,
          "tbl_dialogue.text": "돌아오셨네요. 회의 내용은 정리해 뒀어요."
        }
      },
      {
        "rowId": "row_tbl_dialogue_0072",
        "cells": {
          "tbl_dialogue.id": 60014,
          "tbl_dialogue.character_id": 10003,
          "tbl_dialogue.area_id": null,
          "tbl_dialogue.min_affinity_id": 70001,
          "tbl_dialogue.dialogue_type": "greeting_return",
          "tbl_dialogue.from_hour": 18,
          "tbl_dialogue.to_hour": 21,
          "tbl_dialogue.text": "선배, 다시 오셨군요. 야간 근무가 시작됐어요."
        }
      },
      {
        "rowId": "row_tbl_dialogue_0073",
        "cells": {
          "tbl_dialogue.id": 60015,
          "tbl_dialogue.character_id": 10003,
          "tbl_dialogue.area_id": null,
          "tbl_dialogue.min_affinity_id": 70001,
          "tbl_dialogue.dialogue_type": "greeting_return",
          "tbl_dialogue.from_hour": 21,
          "tbl_dialogue.to_hour": 24,
          "tbl_dialogue.text": "선배도 아직 안 자고 있었군요."
        }
      },
      {
        "rowId": "row_tbl_dialogue_0074",
        "cells": {
          "tbl_dialogue.id": 60016,
          "tbl_dialogue.character_id": 10003,
          "tbl_dialogue.area_id": null,
          "tbl_dialogue.min_affinity_id": 70001,
          "tbl_dialogue.dialogue_type": "greeting_return",
          "tbl_dialogue.from_hour": 0,
          "tbl_dialogue.to_hour": 6,
          "tbl_dialogue.text": "다시 와줘서 다행이에요. 오늘은 유난히 조용했거든요."
        }
      },
      {
        "rowId": "row_tbl_dialogue_0075",
        "cells": {
          "tbl_dialogue.id": 60008,
          "tbl_dialogue.character_id": 10001,
          "tbl_dialogue.area_id": 20001,
          "tbl_dialogue.min_affinity_id": 70001,
          "tbl_dialogue.dialogue_type": "idle",
          "tbl_dialogue.from_hour": null,
          "tbl_dialogue.to_hour": null,
          "tbl_dialogue.text": "선배도 바쁘죠? 저는 괜찮아요."
        }
      },
      {
        "rowId": "row_tbl_dialogue_0076",
        "cells": {
          "tbl_dialogue.id": 60009,
          "tbl_dialogue.character_id": 10001,
          "tbl_dialogue.area_id": 20006,
          "tbl_dialogue.min_affinity_id": 70003,
          "tbl_dialogue.dialogue_type": "relation",
          "tbl_dialogue.from_hour": null,
          "tbl_dialogue.to_hour": null,
          "tbl_dialogue.text": "선배, 여기 앉으실래요? 오늘 얘기하고 있었어요."
        }
      },
      {
        "rowId": "row_tbl_dialogue_0077",
        "cells": {
          "tbl_dialogue.id": 60010,
          "tbl_dialogue.character_id": 10001,
          "tbl_dialogue.area_id": 20001,
          "tbl_dialogue.min_affinity_id": 70002,
          "tbl_dialogue.dialogue_type": "relation",
          "tbl_dialogue.from_hour": null,
          "tbl_dialogue.to_hour": null,
          "tbl_dialogue.text": "선배 오면 사무실이 좀 덜 조용해서 좋아요."
        }
      },
      {
        "rowId": "row_tbl_dialogue_0078",
        "cells": {
          "tbl_dialogue.id": 60011,
          "tbl_dialogue.character_id": 10001,
          "tbl_dialogue.area_id": 20006,
          "tbl_dialogue.min_affinity_id": 70004,
          "tbl_dialogue.dialogue_type": "relation",
          "tbl_dialogue.from_hour": null,
          "tbl_dialogue.to_hour": null,
          "tbl_dialogue.text": "선배랑 여기 있는 시간이 하루 중에 제일 조용해요."
        }
      }
    ],
